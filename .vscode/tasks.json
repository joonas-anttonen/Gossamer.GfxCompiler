{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build Release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Gossamer.GfxCompiler.sln",
                "/property:Configuration=Release",
                "/property:Platform=x64",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}